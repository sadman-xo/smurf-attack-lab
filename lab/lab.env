# lab.env — single source of truth for the Smurf-lab topology.
# Sourced by every script so addresses never drift. Edit here only.

# --- amplifier segment (br-amp) ---
AMP_SUBNET=10.0.10          # /24; hosts are ${AMP_SUBNET}.<n>
AMP_BCAST=10.0.10.255       # directed-broadcast target the attacker aims at
ROUTER_AMP_IP=10.0.10.1     # router interface on the amp side
AMP_COUNT=3                 # number of amplifiers (amp1..ampN => .11 .. .(10+N))

# --- victim segment (br-vic) ---
VIC_SUBNET=10.0.20          # /24
ROUTER_VIC_IP=10.0.20.1     # router interface on the victim side
VICTIM_IP=10.0.20.100       # spoofed source == flood destination (tcpdump here)
ATTACKER_IP=10.0.20.50      # sends ONE (or a few) forged requests

# --- names ---
NS_ROUTER=router
BR_AMP=br-amp
BR_VIC=br-vic

# where measure.sh drops pcaps / result tables
RESULTS_DIR_NAME=results
