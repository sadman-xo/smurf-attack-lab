# lab.env — single source of truth for the Smurf-lab topology.
# Sourced by every script so addresses never drift. Edit here only.

# --- amplifier segment (br-amp) ---
AMP_SUBNET=10.0.10          # /24; hosts are ${AMP_SUBNET}.<n>
AMP_BCAST=10.0.10.255       # directed-broadcast target the attacker aims at
ROUTER_AMP_IP=10.0.10.1     # router interface on the amp side
AMP_COUNT="${AMP_COUNT:-3}" # number of amplifiers (amp1..ampN => .11 .. .(10+N)).
                            # Override per-run, e.g.  AMP_COUNT=8 sudo -E bash setup_lab.sh

# --- victim segment (br-vic) ---
VIC_SUBNET=10.0.20          # /24
ROUTER_VIC_IP=10.0.20.1     # router interface on the victim side
VICTIM_IP=10.0.20.100       # spoofed source == flood destination (tcpdump here)
ATTACKER_IP=10.0.20.50      # sends ONE (or a few) forged requests

# --- Fraggle (UDP) variant ---
# The amplifiers run a tiny UDP echo service so a directed-broadcast UDP packet is
# amplified exactly like the ICMP Smurf. FRAGGLE_SPORT is the spoofed source port
# the flood is echoed back to (the victim isn't listening there, so each reply also
# bumps the victim's Udp:NoPorts counter -- which measure.sh reads).
FRAGGLE_PORT=7              # UDP echo (classic Fraggle target; RFC 862)
FRAGGLE_SPORT=40000        # spoofed source port == where replies land at the victim
# The amplifier responders are detached with setsid and identified for shutdown by
# their unique command line ("src/udp_echo.py"); teardown_lab.sh/defend.sh pkill it.

# --- edge anti-spoof defense (IP source guard) ---
# defend.sh 'spoofguard' installs an nftables bridge-family rule on the attacker's
# access port that drops any frame whose IP source isn't the attacker's real address
# -- source-address validation at the edge (BCP 38 family). This table name is what
# teardown_lab.sh/defend.sh look for to remove it.
SG_TABLE=smurf_sg          # nft bridge table holding the source-guard rule

# --- names ---
NS_ROUTER=router
BR_AMP=br-amp
BR_VIC=br-vic
ATT_PORT=r-att             # router-side veth (bridge port) facing the attacker

# where measure.sh drops pcaps / result tables
RESULTS_DIR_NAME=results
